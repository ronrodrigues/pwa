@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<dialog id="result-dialog">
    <div class="dialog-content flex flex-center">
        @ChildContent
        <br>
        <button
            @onclick="HideModalAsync"
            class="btn btn-filled mb">
            Registrar IMC
        </button>
    </div>
</dialog>

@code
{
    [Parameter] [EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public EventCallback OnModalCloseCallback { get; set; }

    public async Task ShowModelAsync()
    {
        await JsRuntime.InvokeVoidAsync("showModal", "result-dialog");
        StateHasChanged();
    }

    private async Task HideModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("hideModal", "result-dialog");
        Navigation.NavigateTo("#history");
        await OnModalCloseCallback.InvokeAsync();
    }
}
